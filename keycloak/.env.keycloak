# =============================================================================
# Keycloak - E-Commerce Platform Environment Configuration
# =============================================================================
# Copy this file to .env and update all values before starting Keycloak.

# ---------------------------------------------------------------------------
# HOSTNAME
# ---------------------------------------------------------------------------
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

KC_HTTP_PORT=8080
KC_HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# SMTP - Email Configuration (Required for email verification, password reset)
# ---------------------------------------------------------------------------
KC_SMTP_HOST=smtp.gmail.com
KC_SMTP_PORT=587
KC_SMTP_USER=your-smtp-email@example.com
# Password stored in: ./secrets/kc_smtp_password.txt
KC_SMTP_FROM=noreply@yourdomain.com
KC_SMTP_STARTTLS=true
KC_SMTP_SSL=false

# ---------------------------------------------------------------------------
# Database - PostgreSQL (Required for production)
# ---------------------------------------------------------------------------
# DB password stored in: ./secrets/kc_db_password.txt

# ---------------------------------------------------------------------------
# Admin Account (Required for first login)
# ---------------------------------------------------------------------------
# Admin password stored in: ./secrets/kc_admin_password.txt
# Admin username: admin (fixed in docker-compose)
